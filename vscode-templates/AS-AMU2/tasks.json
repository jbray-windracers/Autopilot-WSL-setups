{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "AS-AMU2: Init submodules",
            "type": "shell",
            "command": "git submodule update --init --recursive",
            "problemMatcher": []
        },
        {
            "label": "AS-AMU2: Build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "AS-AMU2: Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "AS-AMU2: Generate compile_commands.json (bear)",
            "type": "shell",
            "command": "make clean && bear -- make -j$(nproc)",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "AS-AMU2: Flash (dfu-util)",
            "type": "shell",
            "command": "dfu-util -a 0 -R -D build/AMU2.dfu",
            "problemMatcher": [],
            "dependsOn": ["AS-AMU2: Build"]
        }
    ]
}
