{
    // Deployed per-repo by dev-setup/windows-bootstrap.ps1. OpenOCD + ST-Link
    // loads (flashes) build/__NAME__.elf, then Cortex-Debug gives variables,
    // core registers and a memory viewer. The ST-Link is a plain USB device
    // on Windows - no passthrough/attach step needed.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "__REPO__: Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/__NAME__.elf",
            "searchDir": ["${env:OPENOCD_SCRIPTS}"],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "device": "STM32F407VG",
            "runToEntryPoint": "main",
            "preLaunchTask": "__REPO__: Build",
            "showDevDebugOutput": "none"
        }
    ]
}
