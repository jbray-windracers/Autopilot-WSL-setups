{
    // Deployed per-repo by dev-setup/wsl-bootstrap.sh: __REPO__ -> repo folder
    // name, __NAME__ -> Makefile PROJECT / build output name (repo minus "AS-").
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "__REPO__: Build",
            "detail": "make -> build/__NAME__.{elf,bin,hex,dfu,dmp,list,map}",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "__REPO__: Generate compile_commands.json (bear)",
            "detail": "Refresh IntelliSense: make clean && bear -- make -j$(nproc)",
            "type": "shell",
            "command": "make clean && bear -- make -j$(nproc)",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "__REPO__: Flash",
            "detail": "Flash build/__NAME__.elf to the STM32F407 over SWD/ST-Link with STM32_Programmer_CLI, then reset & run",
            "type": "shell",
            "command": "STM32_Programmer_CLI -c port=SWD mode=UR -d build/__NAME__.elf -rst",
            "problemMatcher": [],
            "dependsOn": ["__REPO__: Build"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
