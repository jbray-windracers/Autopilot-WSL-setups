{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AS-FCU: Debug SITL (FCU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sitl/bin/FCU",
            "args": ["--model", "plane", "--home", "-35.363261,149.165230,584,353", "--speedup", "1"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "AS-FCU: Build SITL (plane)"
        },
        {
            "name": "AS-FCU: Debug CubeOrange (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/CubeOrange/bin/FCU.elf",
            "configFiles": ["interface/stlink.cfg", "target/stm32h7x.cfg"],
            "device": "STM32H743ZI",
            "runToEntryPoint": "main",
            "preLaunchTask": "AS-FCU: Build CubeOrange (plane)"
        },
        {
            "name": "AS-FCU: Attach CubeOrange (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/CubeOrange/bin/FCU.elf",
            "configFiles": ["interface/stlink.cfg", "target/stm32h7x.cfg"],
            "device": "STM32H743ZI"
        }
    ]
}
