{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "AS-ADS: Init submodules",
            "type": "shell",
            "command": "git submodule update --init --recursive",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "AS-ADS: Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Generate compile_commands.json (bear)",
            "type": "shell",
            "command": "make clean && bear -- make -j$(nproc)",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "AS-ADS: Flash (dfu-util)",
            "type": "shell",
            "command": "dfu-util -a 0 -R -D build/ADS.dfu",
            "problemMatcher": [],
            "dependsOn": ["AS-ADS: Build"]
        }
    ]
}
