{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "AS-ADS: Init submodules",
            "type": "shell",
            "command": "git submodule update --init --recursive",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Install toolchain dependencies",
            "type": "shell",
            "command": "dpkg -s libnewlib-arm-none-eabi >/dev/null 2>&1 && dpkg -s libstdc++-arm-none-eabi-newlib >/dev/null 2>&1 || sudo apt-get install -y libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["AS-ADS: Install toolchain dependencies"],
            "dependsOrder": "sequence"
        },
        {
            "label": "AS-ADS: Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Generate compile_commands.json (bear)",
            "type": "shell",
            "command": "make clean && bear -- make -j$(nproc)",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "AS-ADS: Install flashing dependencies",
            "type": "shell",
            "command": "dpkg -s dfu-util usbutils >/dev/null 2>&1 || sudo apt-get install -y dfu-util usbutils",
            "problemMatcher": []
        },
        {
            "label": "AS-ADS: Flash (dfu-util)",
            "type": "shell",
            "command": "dfu-util -a 0 -s 0x08000000:leave -D build/ADS.bin",
            "problemMatcher": [],
            "dependsOn": ["AS-ADS: Build", "AS-ADS: Install flashing dependencies"],
            "dependsOrder": "sequence"
        }
    ]
}
